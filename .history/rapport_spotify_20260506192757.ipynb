   ],
   "source": [
    "from scipy.spatial.distance import pdist, squareform\n",
    "\n",
    "# 1. Mapping sous-genre → genre parent\n",
    "mapping = data_complete[['playlist_subgenre', 'playlist_genre']].drop_duplicates()\n",
    "mapping = mapping.set_index('playlist_subgenre')['playlist_genre'].to_dict()\n",
    "\n",
    "# 2. Calcul des centroïdes\n",
    "features = ['danceability', 'energy', 'loudness', 'speechiness', 'acousticness',\n",
    "            'instrumentalness', 'liveness', 'valence', 'tempo', 'duration_ms']\n",
    "centroids = subgenre_stats.groupby('playlist_subgenre')[features].mean()\n",
    "\n",
    "# 3. Matrice de distances euclidiennes\n",
    "distance_matrix = squareform(pdist(centroids.values, metric='euclidean'))\n",
    "dist_matrix = pd.DataFrame(distance_matrix, index=centroids.index, columns=centroids.index)\n",
    "\n",
    "# 4. Tri des sous-genres par genre parent\n",
    "sorted_subgenres = sorted(centroids.index, key=lambda x: (mapping.get(x), x))\n",
    "dist_matrix_sorted = dist_matrix.loc[sorted_subgenres, sorted_subgenres]\n",
    "\n",
    "# 5. Visualisation\n",
    "fig, ax = plt.subplots(figsize=(16, 12))\n",
    "\n",
    "sns.heatmap(dist_matrix_sorted, cmap=\"YlGnBu_r\", ax=ax,\n",
    "            cbar_kws={'label': 'Distance Euclidienne'})\n",
    "ax.set_title(\"Proximité Acoustique : Distances regroupées par Genre\", fontsize=15)\n",
    "\n",
    "# 6. Lignes de séparation entre les blocs de genres\n",
    "current_pos = 0\n",
    "for genre in sorted(set(mapping.values())):\n",
    "    count = list(mapping.values()).count(genre)\n",
    "    ax.axhline(current_pos + count, color='black', lw=2, alpha=0.7)\n",
    "    ax.axvline(current_pos + count, color='black', lw=2, alpha=0.7)\n",
    "    current_pos += count\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",

   "source": [
    "### PCA \n",
    "\n",
    "cols_to_exclude = [\n",
    "    'track_artist',\n",
    "    'avg_popularity',\n",
    "    'hit_rate',\n",
    "    'popularity_trend',\n",
    "    'popularity_variability'\n",
    "]\n",
    "\n",
    "# 1. Select numeric variables\n",
    "X = (\n",
    "    artist_features_50plus\n",
    "    .select_dtypes(include='number')\n",
    "    .drop(columns=cols_to_exclude, errors='ignore')\n",
    ")\n",
    "\n",
    "# 2. Handle missing values\n",
    "X = X.fillna(X.median())\n",
    "\n",
    "# 3. Scale variables (CRUCIAL for PCA)\n",
    "scaler = StandardScaler()\n",
    "X_scaled = scaler.fit_transform(X)\n",
    "\n",
    "# 4. PCA\n",
    "pca = PCA()\n",
    "X_pca = pca.fit_transform(X_scaled)\n",
    "\n",
    "explained_var = pca.explained_variance_ratio_\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "plt.plot(\n",
    "    range(1, len(explained_var) + 1),\n",
    "    explained_var,\n",
    "    marker='o'\n",
    ")\n",
    "\n",
    "plt.title(\"Explained Variance by Principal Components\")\n",
    "plt.xlabel(\"Principal Component\")\n",
    "plt.ylabel(\"Explained Variance Ratio\")\n",
    "\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "cum_var = np.cumsum(explained_var)\n",
    "\n",
    "plt.figure(figsize=(8,5))\n",
    "\n",
    "plt.plot(\n",
    "    range(1, len(cum_var) + 1),\n",
    "    cum_var,\n",
    "    marker='o'\n",
    ")\n",
    "\n",
    "plt.axhline(\n",
    "    y=0.8,\n",
    "    color='red',\n",
    "    linestyle='--',\n",
    "    label='80% variance'\n",
    ")\n",
    "\n",
    "plt.title(\"Cumulative Explained Variance\")\n",
    "plt.xlabel(\"Number of Components\")\n",
    "plt.ylabel(\"Cumulative Variance\")\n",
    "\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "### PROJECTED PTS\n",
    "plt.figure(figsize=(18, 5))\n",
    "\n",
    "c = artist_features_50plus['avg_popularity']\n",
    "\n",
    "plt.subplot(1, 3, 1)\n",
    "plt.scatter(X_pca[:, 0], X_pca[:, 1], c=c, alpha=0.7)\n",
    "plt.title(\"PC1 vs PC2\")\n",
    "plt.xlabel(f\"PC1 ({pca.explained_variance_ratio_[0]:.1%})\")\n",
    "plt.ylabel(f\"PC2 ({pca.explained_variance_ratio_[1]:.1%})\")\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.subplot(1, 3, 2)\n",
    "plt.scatter(X_pca[:, 0], X_pca[:, 2], c=c, alpha=0.7)\n",
    "plt.title(\"PC1 vs PC3\")\n",
    "plt.xlabel(f\"PC1 ({pca.explained_variance_ratio_[0]:.1%})\")\n",
    "plt.ylabel(f\"PC3 ({pca.explained_variance_ratio_[2]:.1%})\")\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.subplot(1, 3, 3)\n",
    "plt.scatter(X_pca[:, 1], X_pca[:, 2], c=c, alpha=0.7)\n",
    "plt.title(\"PC2 vs PC3\")\n",
    "plt.xlabel(f\"PC2 ({pca.explained_variance_ratio_[1]:.1%})\")\n",
    "plt.ylabel(f\"PC3 ({pca.explained_variance_ratio_[2]:.1%})\")\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "\n",
    "# CIRCLE VAR\n",
    "\n",
    "loadings = (\n",
    "    pca.components_.T *\n",
    "    np.sqrt(pca.explained_variance_)\n",
    ")\n",
    "\n",
    "loadings_df = pd.DataFrame(\n",
    "    loadings,\n",
    "    columns=[f'PC{i+1}' for i in range(loadings.shape[1])],\n",
    "    index=X.columns\n",
    ")\n",
    "\n",
    "\n",
    "plt.figure(figsize=(9,9))\n",
    "plt.axhline(0)\n",
    "plt.axvline(0)\n",
    "plt.xlim(-1.1, 1.1)\n",
    "plt.ylim(-1.1, 1.1)\n",
    "\n",
    "# Unit circle\n",
    "circle = plt.Circle((0,0), 1, fill=False)\n",
    "plt.gca().add_artist(circle)\n",
    "\n",
    "for var in loadings_df.index:\n",
    "    x = loadings_df.loc[var, 'PC1']\n",
    "    y = loadings_df.loc[var, 'PC2']\n",
    "    plt.arrow(\n",
    "        0,\n",
    "        0,\n",
    "        x,\n",
    "        y,\n",
    "        head_width=0.03,\n",
    "        head_length=0.03,\n",
    "        linewidth=1,\n",
    "        color=\"tomato\",\n",
    "        alpha=0.8\n",
    "    )\n",
    "    plt.text(\n",
    "        x * 1.12,\n",
    "        y * 1.12,\n",
    "        var,\n",
    "        fontsize=10,\n",
    "        ha='center'\n",
    "    )\n",
    "\n",
    "plt.title(\"Correlation Circle (PC1 vs PC2)\")\n",
    "plt.xlabel(\n",
    "    f\"PC1 ({pca.explained_variance_ratio_[0]:.1%})\"\n",
    ")\n",
    "plt.ylabel(\n",
    "    f\"PC2 ({pca.explained_variance_ratio_[1]:.1%})\"\n",
    ")\n",
    "plt.grid(alpha=0.2)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
